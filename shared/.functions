#!/bin/bash
# Custom shell functions - shared across different shells

# Create a directory and cd into it
mkcd() {
    mkdir -p "$1" && cd "$1"
}

# Extract various archive formats
extract() {
    if [ -f "$1" ]; then
        case "$1" in
            *.tar.bz2)   tar xjf "$1"    ;;
            *.tar.gz)    tar xzf "$1"    ;;
            *.bz2)       bunzip2 "$1"    ;;
            *.rar)       unrar x "$1"    ;;
            *.gz)        gunzip "$1"     ;;
            *.tar)       tar xf "$1"     ;;
            *.tbz2)      tar xjf "$1"    ;;
            *.tgz)       tar xzf "$1"    ;;
            *.zip)       unzip "$1"      ;;
            *.Z)         uncompress "$1" ;;
            *.7z)        7z x "$1"       ;;
            *.tar.xz)    tar xf "$1"     ;;
            *)           echo "'$1' cannot be extracted via extract()" ;;
        esac
    else
        echo "'$1' is not a valid file"
    fi
}

# Create a backup of a file
backup() {
    if [ -f "$1" ]; then
        cp "$1" "$1.backup-$(date +%Y%m%d-%H%M%S)"
        echo "Backup created: $1.backup-$(date +%Y%m%d-%H%M%S)"
    else
        echo "File not found: $1"
    fi
}

# Find file by name
ff() {
    find . -type f -iname "*$1*" 2>/dev/null
}

# Find directory by name
fd() {
    find . -type d -iname "*$1*" 2>/dev/null
}

# Search in file contents
search() {
    grep -r -i "$1" . 2>/dev/null
}

# Get file size in human readable format
filesize() {
    if [ -f "$1" ]; then
        du -h "$1" | cut -f1
    else
        echo "File not found: $1"
    fi
}

# Quick HTTP server in current directory
serve() {
    local port="${1:-8000}"
    python3 -m http.server "$port"
}

# Weather report
weather() {
    local location="${1:-}"
    curl -s "wttr.in/$location"
}

# Show all TODO/FIXME comments in current directory
todos() {
    grep -rn --color=always -E "TODO|FIXME|XXX|HACK|BUG" . 2>/dev/null | grep -v ".git"
}

# Git: Create a new branch and switch to it
gnb() {
    if [ -z "$1" ]; then
        echo "Usage: gnb <branch-name>"
        return 1
    fi
    git checkout -b "$1"
}

# Git: Show branches sorted by last commit
gbsort() {
    git for-each-ref --sort=-committerdate refs/heads/ --format='%(HEAD) %(color:yellow)%(refname:short)%(color:reset) - %(color:red)%(objectname:short)%(color:reset) - %(contents:subject) - %(authorname) (%(color:green)%(committerdate:relative)%(color:reset))'
}

# Git: Interactive add
gai() {
    git add -i
}

# Docker: Stop and remove all containers
dstop() {
    docker stop $(docker ps -a -q) 2>/dev/null
}

# Docker: Remove all stopped containers
drma() {
    docker rm $(docker ps -a -q) 2>/dev/null
}

# Docker: Enter a running container
denter() {
    if [ -z "$1" ]; then
        echo "Usage: denter <container-name-or-id>"
        return 1
    fi
    docker exec -it "$1" /bin/bash || docker exec -it "$1" /bin/sh
}

# Show PATH entries one per line
paths() {
    echo "$PATH" | tr ':' '\n'
}

# Check if a command exists
cmd_exists() {
    command -v "$1" &> /dev/null
}

# Get public IP address
myip2() {
    curl -s https://api.ipify.org
    echo
}

# Get local IP address with extended options
localip() {
    local verbose=false
    local ipv6=false
    local all_versions=false
    local show_mac=false
    local show_gateway=false
    local filter_interface=""

    # Parse arguments
    while [ $# -gt 0 ]; do
        case "$1" in
            -v|--verbose)
                verbose=true
                ;;
            -6|--ipv6)
                ipv6=true
                ;;
            -a|--all)
                all_versions=true
                ipv6=true
                ;;
            --mac)
                show_mac=true
                verbose=true
                ;;
            --gateway)
                show_gateway=true
                verbose=true
                ;;
            -i|--interface)
                filter_interface="$2"
                shift
                ;;
            -h|--help)
                cat <<EOF
Usage: localip [options]

Options:
  -v, --verbose       Show interface names and netmask
  -6, --ipv6          Show IPv6 addresses only
  -a, --all           Show both IPv4 and IPv6
  --mac               Show MAC addresses (implies -v)
  --gateway           Show gateway (implies -v)
  -i, --interface     Filter by specific interface
  -h, --help          Show this help message

Examples:
  localip              # Show IPv4 addresses
  localip -v           # Show IPv4 with interface names
  localip -a           # Show both IPv4 and IPv6
  localip --mac        # Show IPs and MAC addresses
  localip -i eth0      # Show address of eth0 only
EOF
                return 0
                ;;
            *)
                echo "Unknown option: $1"
                return 1
                ;;
        esac
        shift
    done

    if cmd_exists ip; then
        # IPv4
        if [ "$ipv6" = false ] || [ "$all_versions" = true ]; then
            if [ "$verbose" = true ] || [ "$all_versions" = true ]; then
                echo "=== IPv4 Addresses ==="
            fi
            
            if [ -n "$filter_interface" ]; then
                local filter_cmd="grep $filter_interface"
            else
                local filter_cmd="cat"
            fi

            ip -o -4 addr show scope global | $filter_cmd | while read -r line; do
                local iface=$(echo "$line" | awk '{print $2}')
                local ip_addr=$(echo "$line" | awk '{print $4}' | cut -d/ -f1)
                local netmask=$(echo "$line" | awk '{print $4}' | cut -d/ -f2)
                local state=$(ip link show "$iface" | grep -o "UP\|DOWN" | head -1)
                
                if [ "$verbose" = true ]; then
                    echo "Interface: $iface | State: $state | IP: $ip_addr/$netmask"
                    
                    if [ "$show_mac" = true ]; then
                        local mac=$(ip link show "$iface" | awk '/link\/ether/ {print $2}')
                        echo "  MAC: $mac"
                    fi
                    
                    if [ "$show_gateway" = true ]; then
                        local gateway=$(ip route show | grep "default via" | grep "$iface" | awk '{print $3}')
                        if [ -n "$gateway" ]; then
                            echo "  Gateway: $gateway"
                        fi
                    fi
                else
                    echo "$ip_addr"
                fi
            done
        fi

        # IPv6
        if [ "$ipv6" = true ]; then
            if [ "$verbose" = true ] || [ "$all_versions" = true ]; then
                echo "=== IPv6 Addresses ==="
            fi
            
            if [ -n "$filter_interface" ]; then
                local filter_cmd="grep $filter_interface"
            else
                local filter_cmd="cat"
            fi

            ip -o -6 addr show scope global | $filter_cmd | while read -r line; do
                local iface=$(echo "$line" | awk '{print $2}')
                local ip_addr=$(echo "$line" | awk '{print $4}' | cut -d/ -f1)
                local netmask=$(echo "$line" | awk '{print $4}' | cut -d/ -f2)
                
                if [ "$verbose" = true ]; then
                    echo "Interface: $iface | IPv6: $ip_addr/$netmask"
                else
                    echo "$ip_addr"
                fi
            done
        fi
    elif cmd_exists ifconfig; then
        if [ "$ipv6" = false ] || [ "$all_versions" = true ]; then
            if [ "$verbose" = true ] || [ "$all_versions" = true ]; then
                echo "=== IPv4 Addresses ==="
            fi
            
            ifconfig | awk -v filter="$filter_interface" -v verbose="$verbose" -v show_mac="$show_mac" '
                /^[^[:space:]]/ { 
                    iface=$1; 
                    sub(":", "", iface);
                    if (filter == "" || iface == filter) {
                        current_iface=iface;
                        in_target=1;
                    } else {
                        in_target=0;
                    }
                }
                in_target && /inet / && $2 != "127.0.0.1" { 
                    ip=$2;
                    if (verbose == "true") {
                        print "Interface: " current_iface " | IP: " ip;
                    } else {
                        print ip;
                    }
                }
                in_target && show_mac == "true" && /HWaddr|ether/ {
                    mac=$NF;
                    print "  MAC: " mac;
                }
            '
        fi
    else
        echo "❌ Neither 'ip' nor 'ifconfig' is available"
        return 1
    fi
}

# Kill process by name
killp() {
    if [ -z "$1" ]; then
        echo "Usage: killp <process-name>"
        return 1
    fi
    ps aux | grep "$1" | grep -v grep | awk '{print $2}' | xargs kill -9 2>/dev/null
    echo "Killed processes matching: $1"
}

# Create a random password
genpasswd() {
    local length="${1:-20}"
    openssl rand -base64 48 | cut -c1-"$length"
}

# Port check
portcheck() {
    if [ -z "$1" ]; then
        echo "Usage: portcheck <port>"
        return 1
    fi
    lsof -i :"$1" || echo "Port $1 is not in use"
}

# JSON pretty print
jsonpp() {
    if [ -f "$1" ]; then
        python3 -m json.tool "$1"
    else
        echo "$1" | python3 -m json.tool
    fi
}

# Disk usage sorted
dusort() {
    du -ah "${1:-.}" 2>/dev/null | sort -hr | head -20
}

# Show colored diff
cdiff() {
    diff -u "$@" | colordiff | less -R
}

# Update all Git repositories in current directory
gitup() {
    find . -maxdepth 1 -type d -exec sh -c '(cd {} && git pull 2>/dev/null)' \;
}

# Git pull request info
git-pr-info() {
  # Si aucun argument n'est fourni, on utilise le comportement par défaut
  if [ $# -eq 0 ] || [[ "$1" == "--copy" ]]; then
    # Détection automatique de la branche de base (main, develop, master)
    BASE_BRANCH=$(git branch -r \
      | grep -E 'origin/(main|develop|master)' \
      | grep -v 'HEAD ->' \
      | head -n 1 \
      | sed 's/origin\///' \
      | tr -d '[:space:]')

    COMPARE_BRANCH="HEAD" # On compare avec la branche courante
    COPY_MODE=false

    # Si le premier argument est --copy, on active le mode copie
    if [[ "$1" == "--copy" ]]; then
      COPY_MODE=true
    fi
  else
    # Sinon, on utilise les branches spécifiées par l'utilisateur
    BASE_BRANCH="$1"
    COMPARE_BRANCH="$2"

    # Vérification que les branches existent
    if ! git show-ref --verify --quiet refs/heads/"$BASE_BRANCH" && ! git show-ref --verify --quiet refs/remotes/origin/"$BASE_BRANCH"; then
      echo "❌ La branche de base '$BASE_BRANCH' n'existe pas localement ou sur origin."
      return 1
    fi

    if ! git show-ref --verify --quiet refs/heads/"$COMPARE_BRANCH" && ! git show-ref --verify --quiet refs/remotes/origin/"$COMPARE_BRANCH"; then
      echo "❌ La branche à comparer '$COMPARE_BRANCH' n'existe pas localement ou sur origin."
      return 1
    fi

    # Si le troisième argument est --copy, on active le mode copie
    if [[ "$3" == "--copy" ]]; then
      COPY_MODE=true
    fi
  fi

  # Récupération des commits entre les deux branches
  OUTPUT=$(git log "$BASE_BRANCH".."$COMPARE_BRANCH" --oneline --name-only --pretty=format:"---%n%h %s%n%b%n Fichiers : %n")

  if [ -z "$OUTPUT" ]; then
    echo "✅ Aucun nouveau commit entre '$BASE_BRANCH' et '$COMPARE_BRANCH'"
    return
  fi

  echo "📘 Comparaison entre '$BASE_BRANCH' et '$COMPARE_BRANCH'"
  echo ""

  # Gestion de l’option --copy
  if [ "$COPY_MODE" = true ]; then
    if command -v pbcopy >/dev/null 2>&1; then
      echo "$OUTPUT" | pbcopy
      echo "📋 Commits copiés dans le presse-papiers (macOS)"
    elif command -v xclip >/dev/null 2>&1; then
      echo "$OUTPUT" | xclip -selection clipboard
      echo "📋 Commits copiés dans le presse-papiers (Linux/xclip)"
    elif command -v wl-copy >/dev/null 2>&1; then
      echo "$OUTPUT" | wl-copy
      echo "📋 Commits copiés dans le presse-papiers (Linux/Wayland)"
    else
      echo "⚠️ Impossible de copier : aucun utilitaire de presse-papiers trouvé"
    fi
  else
    echo "$OUTPUT"
  fi
}
# Security / SSH / GPG

generate_ssh_key() {
    local email=$1
    local key_path=$2
    ssh-keygen -t rsa -b 4096 -C "$email" -f "$key_path" -N ""
    eval "$(ssh-agent -s)"
    ssh-add "$key_path"
    echo "SSH key generated and added to the SSH agent."
}

show_ssh_public_key() {
    local key_path=$1
    echo "Your SSH public key :"
    cat "${key_path}.pub"
}

generate_gpg_key() {
    local name=$1
    local email=$2
    gpg --batch --gen-key <<-EOF
        Key-Type: RSA
        Key-Length: 4096
        Subkey-Type: RSA
        Subkey-Length: 4096
        Name-Real: $name
        Name-Email: $email
        Expire-Date: 0
        %commit
EOF
    echo "GPG key generated."
}

show_gpg_public_key() {
    local email=$1
    local gpg_key_id=$(gpg --list-keys --with-colons | grep -B 1 "$email" | head -n 1 | cut -d ':' -f 5)
    echo "Your public GPG key :"
    gpg --armor --export "$gpg_key_id"
}

# List or search defined aliases and functions
listdefs() {
    local pattern="${1:-}"

    local alias_file="${DOTFILES_SHARED_DIR:-$HOME/.dotfiles/shared}/.aliases"
    local func_file="${DOTFILES_SHARED_DIR:-$HOME/.dotfiles/shared}/.functions"

    echo "=== Aliases ==="
    if [ -f "$alias_file" ]; then
        if [ -n "$pattern" ]; then
            # Show 'alias name=...' lines filtered by pattern
            grep -E "^[[:space:]]*alias[[:space:]]+.*${pattern}.*" "$alias_file" || echo "No aliases match '$pattern'"
        else
            # Show all alias definitions
            grep -E "^[[:space:]]*alias[[:space:]]+" "$alias_file" || echo "No aliases defined"
        fi
    else
        echo "Alias file not found: $alias_file"
    fi

    echo
    echo "=== Functions ==="
    if [ -f "$func_file" ]; then
        if [ -n "$pattern" ]; then
            # List function names matching the pattern
            awk -v pat="$pattern" '
                /^[[:space:]]*[A-Za-z_][A-Za-z0-9_]*[[:space:]]*\(\)[[:space:]]*\{/ {
                    name = $1
                    sub(/\(\){?$/, "", name)
                    if (name ~ pat) print name
                }
            ' "$func_file" | sort -u || echo "No functions match '$pattern'"
        else
            # List all function names
            awk '
                /^[[:space:]]*[A-Za-z_][A-Za-z0-9_]*[[:space:]]*\(\)[[:space:]]*\{/ {
                    name = $1
                    sub(/\(\){?$/, "", name)
                    print name
                }
            ' "$func_file" | sort -u || echo "No functions defined"
        fi
    else
        echo "Functions file not found: $func_file"
    fi
}

# System Monitoring

# Check memory usage
memcheck() {
    if cmd_exists free; then
        echo "=== Memory Usage ==="
        free -h
    else
        echo "Memory info not available"
    fi
}

# Count CPU cores
cpucount() {
    if cmd_exists nproc; then
        echo "CPU cores: $(nproc)"
    elif [ -f /proc/cpuinfo ]; then
        echo "CPU cores: $(grep -c "^processor" /proc/cpuinfo)"
    else
        echo "Could not determine CPU count"
    fi
}

# Find and show process details
whichproc() {
    if [ -z "$1" ]; then
        echo "Usage: whichproc <process-name>"
        return 1
    fi
    ps aux | grep "$1" | grep -v grep
}

# Network Functions

# Test internet connection
testconn() {
    echo "Testing internet connection..."
    if ping -c 1 8.8.8.8 &> /dev/null; then
        echo "✅ Internet connection: OK"
        return 0
    else
        echo "❌ Internet connection: FAILED"
        return 1
    fi
}

# Check DNS resolution
dns-check() {
    local host="${1:-google.com}"
    echo "Checking DNS for $host..."
    if cmd_exists nslookup; then
        nslookup "$host"
    elif cmd_exists dig; then
        dig "$host"
    else
        echo "Neither nslookup nor dig available"
        return 1
    fi
}

# Git Maintenance

# Clean up deleted branches from remote
gitclean() {
    echo "Cleaning up remote tracking branches..."
    git fetch --prune
    echo "✅ Cleaned remote branches"
    
    echo "Removing merged branches..."
    git branch --merged | grep -v "\*" | grep -v "main" | grep -v "master" | grep -v "develop" | xargs -r git branch -d
    echo "✅ Removed merged local branches"
}

# Find a branch by pattern
git-find-branch() {
    if [ -z "$1" ]; then
        echo "Usage: git-find-branch <pattern>"
        return 1
    fi
    echo "Local branches matching '$1':"
    git branch | grep "$1"
    echo ""
    echo "Remote branches matching '$1':"
    git branch -r | grep "$1"
}

# Make php version switch
phpuse() {
  sudo update-alternatives --set php /usr/bin/php$1
  php -v
}


# tree like function : return the folder architecture as a tree:

ctree(){
    ls -R | grep ":$" | sed -e 's/:$//' -e 's/[^-][^\/]*\//--/g' -e 's/^/   /' -e 's/-/|/'
}