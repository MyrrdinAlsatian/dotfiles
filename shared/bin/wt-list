#!/usr/bin/env bash
set -euo pipefail

# --------------------------------------------------
# wt-list — List git worktrees
# --------------------------------------------------

# shellcheck source=_wt-lib.sh
source "$(dirname "$0")/_wt-lib.sh"

usage() {
  echo ""
  echo "${BOLD}wt-list${RESET} — List git worktrees"
  echo ""
  echo "${BOLD}Usage:${RESET}"
  echo "  wt-list"
  echo "  wt list"
  echo ""
  exit 1
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --help|-h) usage ;;
    *) error "Unknown option: $1"; usage ;;
  esac
done

REPO_ROOT="$(get_repo_root)"
cd "$REPO_ROOT"

echo ""
echo "${BOLD}=== Git Worktrees ===${RESET}"
echo ""

git worktree list --porcelain | awk '
  /^worktree / { path=$2 }
  /^branch /   { branch=substr($2, index($2,"refs/heads/")+11) }
  /^HEAD /     { head=substr($2,1,7) }
  /^$/         {
    if (path != "") {
      printf "  %-40s  %s  %s\n", path, head, branch
      path=""; branch=""; head=""
    }
  }
  END {
    if (path != "") printf "  %-40s  %s  %s\n", path, head, branch
  }
'

echo ""
