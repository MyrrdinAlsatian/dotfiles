#!/usr/bin/env bash
set -euo pipefail

# --------------------------------------------------
# wt-merge — Merge a worktree branch into main and clean up
# --------------------------------------------------
# Workflow:
#   1. Verify branch is ahead of the default branch
#   2. Switch to the default branch
#   3. Merge the feature branch
#   4. Remove the worktree
#   5. Delete the local branch
#   6. Prune stale refs
# --------------------------------------------------

# shellcheck source=_wt-lib.sh
source "$(dirname "$0")/_wt-lib.sh"

usage() {
  echo ""
  echo "${BOLD}wt-merge${RESET} — Merge a worktree branch into main and clean up"
  echo ""
  echo "${BOLD}Usage:${RESET}"
  echo "  wt-merge <branch> [options]"
  echo "  wt merge  <branch> [options]"
  echo ""
  echo "${BOLD}Options:${RESET}"
  echo "  --no-ff        Merge with --no-ff (creates a merge commit)"
  echo "  --squash       Squash commits into one before merging"
  echo "  --help, -h     Show this help"
  echo ""
  exit 1
}

# --------------------------------------------------
# Argument parsing
# --------------------------------------------------

if [[ $# -lt 1 ]]; then
  usage
fi

BRANCH_NAME="$1"
shift

MERGE_FLAGS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --no-ff)   MERGE_FLAGS+=(--no-ff) ;;
    --squash)  MERGE_FLAGS+=(--squash) ;;
    --help|-h) usage ;;
    *) error "Unknown option: $1"; usage ;;
  esac
  shift
done

# --------------------------------------------------
# Resolve paths
# --------------------------------------------------

REPO_ROOT="$(get_repo_root)"
WORKTREE_PATH="$(get_worktree_path "$BRANCH_NAME" "$REPO_ROOT")"
DEFAULT_BRANCH="$(get_default_branch)"

echo ""
echo "${BOLD}=== Merge Worktree ===${RESET}"
info "Branch:         $BRANCH_NAME"
info "Default branch: $DEFAULT_BRANCH"
info "Worktree:       $WORKTREE_PATH"
echo ""

# --------------------------------------------------
# Verify the branch exists
# --------------------------------------------------

if ! branch_exists_locally "$BRANCH_NAME"; then
  error "Branch '$BRANCH_NAME' does not exist locally."
  exit 1
fi

cd "$REPO_ROOT"

# --------------------------------------------------
# Switch to default branch
# --------------------------------------------------

step "Switching to '$DEFAULT_BRANCH'..."
git checkout "$DEFAULT_BRANCH"
success "On branch '$DEFAULT_BRANCH'"
echo ""

# --------------------------------------------------
# Merge
# --------------------------------------------------

step "Merging '$BRANCH_NAME' into '$DEFAULT_BRANCH'..."
git merge "${MERGE_FLAGS[@]}" "$BRANCH_NAME"
success "Merged '$BRANCH_NAME' → '$DEFAULT_BRANCH'"
echo ""

# --------------------------------------------------
# Remove the worktree
# --------------------------------------------------

if git worktree list --porcelain | grep -q "^worktree $WORKTREE_PATH$"; then
  step "Removing worktree at $WORKTREE_PATH..."
  git worktree remove "$WORKTREE_PATH"
  success "Worktree removed"
  echo ""
else
  info "No worktree found at $WORKTREE_PATH — skipping"
  echo ""
fi

# --------------------------------------------------
# Delete the local branch
# --------------------------------------------------

step "Deleting branch '$BRANCH_NAME'..."
git branch -d "$BRANCH_NAME"
success "Branch '$BRANCH_NAME' deleted"
echo ""

# --------------------------------------------------
# Prune stale refs
# --------------------------------------------------

git worktree prune

echo "${BOLD}=== Done ===${RESET}"
success "Merged and cleaned up '$BRANCH_NAME'"
echo ""
