#!/usr/bin/env bash
set -euo pipefail

# --------------------------------------------------
# wt — Git worktree mini-CLI
# --------------------------------------------------
# Usage: wt <command> [args]
#
# Since 'cd' cannot propagate from a sub-process to the calling shell,
# add the following shell function to your .zshrc / .bashrc to get
# seamless directory switching:
#
#   wt() {
#     local dir
#     dir=$(wt-create "$@" 2>&1 >/dev/tty) && cd "$dir"
#   }
#
# Or, for the full CLI:
#
#   wt() {
#     case "$1" in
#       create) shift; local dir; dir=$(wt-create "$@" 2>&1 >/dev/tty) && cd "$dir" ;;
#       *)      command wt "$@" ;;
#     esac
#   }
# --------------------------------------------------

# shellcheck source=_wt-lib.sh
source "$(dirname "$0")/_wt-lib.sh"


usage() {
  echo ""
  echo "${BOLD}wt${RESET} — Git worktree mini-CLI"
  echo ""
  echo "${BOLD}Usage:${RESET}"
  echo "  wt create  <branch> [options]   Create a worktree for <branch>"
  echo "  wt list                         List all worktrees"
  echo "  wt switch  [<branch>]           Switch to a worktree (interactive if no branch)"
  echo "  wt status  [<branch>]           Show status of worktrees"
  echo "  wt info    <branch>             Show detailed info about a worktree"
  echo "  wt diff    <branch1> [<branch2>] Compare branches"
  echo "  wt remove  <branch>             Remove a worktree and delete its branch"
  echo "  wt clean                        Prune broken worktrees and dead refs"
  echo "  wt merge   <branch>             Merge a branch into main and clean up"
  echo ""
  echo "Run ${BOLD}wt <command> --help${RESET} for command-specific options."
  echo ""
  exit 1
}

CMD="${1:-}"
shift 2>/dev/null || true

case "$CMD" in
  create)  exec "$(dirname "$0")/wt-create" "$@" ;;
  list)    exec "$(dirname "$0")/wt-list"   "$@" ;;
  switch)  exec "$(dirname "$0")/wt-switch" "$@" ;;
  status)  exec "$(dirname "$0")/wt-status" "$@" ;;
  info)    exec "$(dirname "$0")/wt-info"   "$@" ;;
  diff)    exec "$(dirname "$0")/wt-diff"   "$@" ;;
  remove)  exec "$(dirname "$0")/wt-remove" "$@" ;;
  clean)   exec "$(dirname "$0")/wt-clean"  "$@" ;;
  merge)   exec "$(dirname "$0")/wt-merge"  "$@" ;;
  --help|-h|help) usage ;;
  *) usage ;;
esac

