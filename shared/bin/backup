#!/bin/bash
# Backup utility script

# Configuration
BACKUP_DIR="${BACKUP_DIR:-$HOME/backups}"
TIMESTAMP=$(date +%Y%m%d-%H%M%S)

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Usage
usage() {
    echo "Usage: $0 <source> [destination]"
    echo
    echo "Examples:"
    echo "  $0 myfile.txt              # Backup to $BACKUP_DIR"
    echo "  $0 myfile.txt /tmp         # Backup to /tmp"
    echo "  $0 /path/to/dir            # Backup entire directory"
    exit 1
}

# Check arguments
if [ $# -lt 1 ]; then
    usage
fi

SOURCE="$1"
DEST="${2:-$BACKUP_DIR}"

# Check if source exists
if [ ! -e "$SOURCE" ]; then
    echo -e "${RED}Error: Source not found: $SOURCE${NC}"
    exit 1
fi

# Create backup directory if it doesn't exist
mkdir -p "$DEST"

# Get basename of source
BASENAME=$(basename "$SOURCE")

# Determine backup filename
if [ -d "$SOURCE" ]; then
    BACKUP_FILE="$DEST/${BASENAME}-${TIMESTAMP}.tar.gz"
    echo -e "${YELLOW}Creating compressed backup of directory...${NC}"
    tar -czf "$BACKUP_FILE" -C "$(dirname "$SOURCE")" "$BASENAME"
else
    BACKUP_FILE="$DEST/${BASENAME}.${TIMESTAMP}"
    echo -e "${YELLOW}Creating backup of file...${NC}"
    cp -p "$SOURCE" "$BACKUP_FILE"
fi

if [ $? -eq 0 ]; then
    echo -e "${GREEN}Backup created successfully:${NC} $BACKUP_FILE"
    ls -lh "$BACKUP_FILE"
else
    echo -e "${RED}Backup failed!${NC}"
    exit 1
fi
